PORT=5000
CLIENT_URL=http://localhost:3000
JWT_SECRET=replace_with_a_strong_random_secret

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/docladder?schema=public"

# Storage Configuration
# Set STORAGE_DRIVER="local" for local disk development (default)
# Set STORAGE_DRIVER="r2" in production when Cloudflare R2 is configured
STORAGE_DRIVER=local

# Cloudflare R2 Credentials (Only required when deploying to Production)
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=doc-ladder-files
# R2_PUBLIC_DOMAIN=https://your-custom-r2-domain.com
